# =====================================================================
# .env.example — copy to server/.env (and client/.env for VITE_ vars).
# NEVER commit real values. NEVER put server secrets in client/.env.
# =====================================================================

# ---------------------------------------------------------------------
# SERVER (server/.env)
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase (free tier; verify current limits) ---------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Bypasses RLS. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Needed only if verifying JWTs locally; otherwise use supabase.auth.getUser(token)
# SUPABASE_JWT_SECRET=your-jwt-secret

# --- Local model runtime (Ollama) ------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Benchmark candidate only. Verify the exact tag and license before adopting.
OLLAMA_MODEL=qwen3:0.6b
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_RETRIES=2

# --- Rate limits and budgets (keep conservative) ---------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_AI_MAX_REQUESTS=5

# --- Research limits (used from Phase 4+) ----------------------------
RESEARCH_MAX_SEARCH_ROUNDS=2
RESEARCH_MAX_RESULTS_PER_TOPIC=5
RESEARCH_MAX_PAGES=20
RESEARCH_MAX_DOC_BYTES=500000
RESEARCH_JOB_TIMEOUT_MS=600000

# --- Search provider (OPEN DECISION — fill in only after verifying
#     current free terms/quotas/ToS; leave blank until then) ----------
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ---------------------------------------------------------------------
# CLIENT (client/.env) — PUBLIC values only, exposed to the browser.
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
